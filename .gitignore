# Terraform working directory
.terraform/

# Terraform state
*.tfstate
*.tfstate.*

# Terraform variable files containing environment-specific values
*.tfvars
*.tfvars.json

# Allow safe example variables
!terraform.tfvars.example

# Terraform plans
*.tfplan
*.plan

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Environment / secrets
.env
.env.*
*.pem
*.key

# AWS local configuration
.aws/

# macOS
.DS_Store
