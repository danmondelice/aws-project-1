aws_region   = "us-east-2"
project_name = "cloud-portfolio"
environment  = "lab"
vpc_cidr     = "10.20.0.0/21"
ha_mode      = false

instance_type       = "t3.micro"
asg_min_size        = 1
asg_desired_capacity = 1
asg_max_size        = 2

db_instance_class        = "db.t3.micro"
db_allocated_storage     = 20
db_max_allocated_storage = 100
db_name                  = "portfolio"
db_username              = "dbadmin"
